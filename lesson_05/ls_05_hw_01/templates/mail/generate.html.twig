<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Генерация писем</title>
</head>
<body>
<h1>Генерация писем</h1>

<form method="get" action="{{ path('mail_generate') }}">
    <label for="recipients">Количество получателей</label>
    <input
            type="number"
            id="recipients"
            name="recipients"
            value="{{ recipientCount }}"
            min="1"
            max="100"
            required
    >
    <button type="submit">Показать поля</button>
</form>

{{ form_start(form) }}
{{ form_errors(form) }}
{{ form_errors(form.recipients) }}

{% for recipient in form.recipients %}
    <fieldset>
        <legend>Получатель {{ loop.index }}</legend>

        {{ form_row(recipient.name) }}
        {{ form_row(recipient.email) }}
    </fieldset>
{% endfor %}

<p><button type="submit">Сгенерировать письма</button></p>
{{ form_end(form) }}
</body>
</html>