{% extends 'base.html.twig' %}

{% block title %}Календарь{% endblock %}

{% block body %}
    <div class="main">
        <h1>Календарь</h1>

        <form action="/calendar" method="get">

            <label>
                Год:
                <input type="number" name="year" min="2000" max="2100" value="{{ "now"|date("Y")}}" required>
            </label>

            <label>
                Месяц:
                <input type="number" name="month" min="1" max="12" value="{{ "now"|date("n")}}" required>
            </label>

            <label>
                Формат:
                <select name="format">
                    <option value="table">Таблица</option>
                    <option value="list">Список</option>
                    <option value="table-weekends">Таблица с выходными</option>
                </select>
            </label>

            <button type="submit">Показать</button>
        </form>
    </div>
{% endblock %}
