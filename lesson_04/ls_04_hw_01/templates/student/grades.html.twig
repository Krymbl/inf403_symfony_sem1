{% extends 'base.html.twig' %}

{% block title %}Табель оценок{% endblock %}

{% block css %}
    <style>
        body { font-family: sans-serif; }
        table { border-collapse: collapse; }
        th, td { border: 1px solid #ccc; padding: 6px 10px; text-align: left; }
        .grade { margin-right: 8px; white-space: nowrap; }
        .flash { padding: 6px 10px; background: #dfd; }
        .flash.error { background: #fdd; }
    </style>
{% endblock %}

{% block body %}
    <h1>Табель оценок</h1>

    {% for label, flashes in app.flashes %}
        {% for flash in flashes %}
            <p class="flash {{ label == 'success' ? '' : 'error' }}">{{ flash }}</p>
        {% endfor %}
    {% endfor %}

    <p id="message" class="flash" hidden></p>

    <p><a href="{{ path('student_create') }}">Добавить студента</a></p>

    <table id="grades"
           data-form-token="{{ csrf_token('grade') }}"
           data-delete-token="{{ csrf_token('delete-grade') }}">
        <thead>
            <tr>
                <th>Студент</th>
                <th>Оценки</th>
                <th>Поставить</th>
            </tr>
        </thead>
        <tbody>
        {% for student in students %}
            <tr>
                <td>
                    <a href="{{ path('student_edit', {id: student.id}) }}">{{ student.fullName }}</a>
                </td>

                <td class="grade-list">
                    {% for grade in student.grades %}
                        <span class="grade">
                            <select class="grade-value" data-url="{{ path('grade_edit', {id: grade.id}) }}">
                                {% for value in 1..5 %}
                                    <option value="{{ value }}" {{ value == grade.value.value ? 'selected' }}>{{ value }}</option>
                                {% endfor %}
                            </select>
                            <button type="button" class="grade-delete"
                                    data-url="{{ path('grade_delete', {id: grade.id}) }}">&times;</button>
                        </span>
                    {% else %}
                        <span class="grade-empty">&mdash;</span>
                    {% endfor %}
                </td>

                <td>
                    <select class="grade-new">
                        {% for value in 1..5 %}
                            <option value="{{ value }}">{{ value }}</option>
                        {% endfor %}
                    </select>
                    <button type="button" class="grade-add"
                            data-url="{{ path('grade_create', {studentId: student.id}) }}">+</button>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="3">Студентов пока нет</td></tr>
        {% endfor %}
        </tbody>
    </table>

    <template id="grade-template"
              data-edit-url="{{ path('grade_edit', {id: 0}) }}"
              data-delete-url="{{ path('grade_delete', {id: 0}) }}">
        <span class="grade">
            <select class="grade-value">
                {% for value in 1..5 %}
                    <option value="{{ value }}">{{ value }}</option>
                {% endfor %}
            </select>
            <button type="button" class="grade-delete">&times;</button>
        </span>
    </template>
{% endblock %}

{% block javascript %}
    <script>
        const table = document.getElementById('grades');
        const template = document.getElementById('grade-template');
        const message = document.getElementById('message');
        const token = table.dataset.formToken;
        const deleteToken = table.dataset.deleteToken;

        function show(text, isError = false) {
            message.textContent = text;
            message.className = isError ? 'flash error' : 'flash';
            message.hidden = false;
        }

        async function post(url, fields) {
            const response = await fetch(url, {
                method: 'POST',
                headers: {'Accept': 'application/json'},
                body: new URLSearchParams(fields),
            });

            const json = await response.json().catch(() => ({}));

            if (!response.ok) {
                show(
                    json.error
                        || Object.values(json.errors || {}).flat().join('\n')
                        || 'Ошибка ' + response.status,
                    true,
                );

                return null;
            }

            return json;
        }

        function buildGrade(json) {
            const node = template.content.firstElementChild.cloneNode(true);

            const select = node.querySelector('.grade-value');
            select.dataset.url = template.dataset.editUrl.replace('/0/', '/' + json.id + '/');
            select.value = String(json.value);

            const button = node.querySelector('.grade-delete');
            button.dataset.url = template.dataset.deleteUrl.replace('/0/', '/' + json.id + '/');

            return node;
        }

        table.addEventListener('change', async (event) => {
            if (event.target.matches('.grade-value')) {
                const json = await post(event.target.dataset.url, {
                    'grade[value]': event.target.value,
                    'grade[_token]': token,
                });

                if (json) {
                    show(json.message);
                }
            }
        });

        table.addEventListener('click', async (event) => {
            const target = event.target;

            if (target.matches('.grade-delete')) {
                const cell = target.closest('.grade-list');
                const json = await post(target.dataset.url, {_token: deleteToken});

                if (json) {
                    target.closest('.grade').remove();

                    if (!cell.querySelector('.grade')) {
                        cell.innerHTML = '<span class="grade-empty">&mdash;</span>';
                    }

                    show(json.message);
                }
            }

            if (target.matches('.grade-add')) {
                const row = target.closest('tr');

                const json = await post(target.dataset.url, {
                    'grade[value]': row.querySelector('.grade-new').value,
                    'grade[_token]': token,
                });

                if (json) {
                    const cell = row.querySelector('.grade-list');
                    cell.querySelector('.grade-empty')?.remove();
                    cell.append(buildGrade(json));

                    show(json.message);
                }
            }
        });
    </script>
{% endblock %}
